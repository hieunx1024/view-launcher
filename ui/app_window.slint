export struct LauncherItemData {
    name: string,
    category: string,
    item_type: string,
    has_icon: bool,
    icon: image,
    exec_or_path: string,
}

export component AppWindow inherits Window {
    title: "View Launcher";
    icon: @image-url("../assets/view-launcher.png");
    no-frame: true;
    background: transparent;
    width: 680px;
    height: 600px;
    default-font-family: "Inter, Ubuntu, Cantarell, Roboto, Noto Sans, DejaVu Sans, sans-serif";
    default-font-size: 14px;

    in-out property <string> search_text: "";
    in-out property <int> selected_index: 0;
    in-out property <length> scroll_viewport_y: 0px;
    in property <[LauncherItemData]> items: [];
    in property <bool> has_results: true;
    in property <string> mode_title: "APPLICATIONS";
    in property <bool> is_file_mode: false;
    in property <string> mode_badge_text: "";
    in property <string> status_item_count: "0 apps";

    // Dynamic Morphing Spotlight Properties
    in-out property <bool> cfg_compact_empty: true;
    in-out property <bool> is_expanded: false;
    property <bool> is_showing_list: (!root.cfg_compact_empty || root.search_text != "" || root.in_settings_mode || root.is_expanded);

    // Action Vector Icons
    in property <image> settings_icon;
    in property <image> nav_icon;
    in property <image> enter_icon;
    in property <image> search_icon;
    in property <image> folder_icon;

    // Empty State Properties
    in property <string> empty_state_title: "No applications found";
    in property <string> empty_state_subtitle: "Try searching for an app, file, or math command";
    in property <bool> is_empty_folder: false;

    // In-App Settings State
    in-out property <bool> in_settings_mode: false;
    in-out property <bool> cfg_autostart: false;
    in-out property <bool> cfg_show_icons: true;
    in-out property <bool> cfg_show_status_bar: true;
    in-out property <bool> cfg_enable_path_matching: true;
    in-out property <int> cfg_max_results: 7;
    in-out property <int> cfg_max_depth: 2;
    in-out property <string> cfg_theme_mode: "dark";
    in-out property <float> cfg_theme_opacity: 0.95;
    in-out property <bool> is_dark: true;
    in-out property <string> settings_status: "";

    // Dynamic Theme Color Tokens
    property <color> col_card_bg: root.is_dark ? rgba(30, 30, 32, root.cfg_theme_opacity) : rgba(255, 255, 255, root.cfg_theme_opacity);
    property <color> col_border: search_input.has-focus ? (root.is_dark ? #0a84ff80 : #0969da80) : (root.is_dark ? #38383a : #d0d7de);
    property <color> col_text_primary: root.is_dark ? #ffffff : #1f2328;
    property <color> col_text_muted: root.is_dark ? #8e8e93 : #656d76;
    property <color> col_text_placeholder: root.is_dark ? #636366 : #8c959f;
    property <color> col_input_text: root.is_dark ? #ffffff : #1f2328;
    property <color> col_selection_bg: root.is_dark ? #007aff : #0969da;
    property <color> col_item_hover: root.is_dark ? #2c2c2e80 : #f0f3f6;
    property <color> col_item_selected_bg: root.is_dark ? #007aff : #0969da;
    property <color> col_badge_bg: root.is_dark ? #2c2c2e : #e6e8ec;
    property <color> col_badge_text: root.is_dark ? #0a84ff : #0969da;
    property <color> col_separator: root.is_dark ? #333336 : #e1e4e8;
    property <color> col_kbd_bg: root.is_dark ? #2c2c2e : #f0f3f6;
    property <color> col_kbd_border: root.is_dark ? #3a3a3c : #d0d7de;
    property <color> col_kbd_text: root.is_dark ? #8e8e93 : #656d76;
    property <color> col_kbd_accent: root.is_dark ? #0a84ff : #0969da;
    property <color> col_settings_card_bg: root.is_dark ? #2c2c2e : #f6f8fa;
    property <color> col_settings_card_border: root.is_dark ? #38383a : #d0d7de;
    property <color> col_settings_card_text: root.is_dark ? #f5f5f7 : #1f2328;
    property <color> col_btn_secondary_bg: root.is_dark ? #2c2c2e : #eaeef2;
    property <color> col_btn_secondary_hover: root.is_dark ? #3a3a3c : #d0d7de;
    property <color> col_btn_secondary_text: root.is_dark ? #ebebf5 : #24292f;

    callback search_text_changed(string);
    callback move_up();
    callback move_down();
    callback item_activated(int);
    callback open_in_terminal(int);
    callback copy_path(int);
    callback open_config();
    callback close_settings();
    callback save_settings(bool, bool, bool, int, int, bool, bool, string, float);
    callback open_raw_config();
    callback close_window();
    callback start_window_drag();
    callback tab_pressed();
    callback handle_backspace() -> bool;

    public function focus_search() {
        search_input.focus();
    }

    public function move_cursor_to_end() {
        search_input.set-selection-offsets(999999, 999999);
    }

    public function focus_settings() {
        settings_focus.focus();
    }

    init => {
        search_input.focus();
    }

    // Main Floating Glassmorphic Container (macOS Spotlight Aesthetic)
    main_card := Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: root.in_settings_mode ? 560px : (root.is_showing_list ? 520px : 56px);
        animate height { duration: 140ms; easing: ease-out; }
        background: root.col_card_bg;
        border-radius: 14px;
        border-width: 1px;
        border-color: root.col_border;
        animate border-color { duration: 150ms; easing: ease-out; }
        clip: true;

        // =========================================================
        // VIEW 1: SPOTLIGHT LAUNCHER VIEW
        // =========================================================
        search_view := VerticalLayout {
            visible: !root.in_settings_mode;
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 0px;
            padding-bottom: root.is_showing_list ? 10px : 0px;
            spacing: 8px;

            // 1. TOP SPOTLIGHT SEARCH BAR (Integrated Drag Region + Magnifying Glass + Clean Input)
            search_box := Rectangle {
                height: 56px;
                background: transparent;

                // Top drag region
                drag_region := TouchArea {
                    width: 100%;
                    height: 100%;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                            root.start_window_drag();
                        }
                    }
                }

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 12px;
                    spacing: 12px;

                    // 1.1 Apple Spotlight Search Icon (Subtle Silver)
                    VerticalLayout {
                        alignment: center;
                        width: 20px;
                        Image {
                            source: root.search_icon;
                            width: 20px;
                            height: 20px;
                            image-fit: contain;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }

                    // 1.2 Text Input & Full-Stretch Placeholder (Spotlight / Raycast Style)
                    Rectangle {
                        horizontal-stretch: 1;
                        clip: true;

                        if root.search_text == "" : Text {
                            x: 0px;
                            y: 0px;
                            width: 100%;
                            height: 100%;
                            text: root.is_file_mode ? "Search files & folders..." : "Search apps, files, or math...";
                            color: root.col_text_placeholder;
                            font-size: 16px;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                        }

                        search_input := TextInput {
                            x: 0px;
                            y: 0px;
                            width: 100%;
                            height: 100%;
                            text <=> root.search_text;
                            single-line: true;
                            font-size: 16px;
                            color: root.col_input_text;
                            selection-background-color: root.col_selection_bg;
                            selection-foreground-color: #ffffff;
                            vertical-alignment: center;
                            horizontal-alignment: left;

                            edited => {
                                root.is_expanded = (self.text != "");
                                root.search_text_changed(self.text);
                            }

                            key-pressed(event) => {
                                if (event.text == Key.Tab) {
                                    root.tab_pressed();
                                    root.move_cursor_to_end();
                                    return accept;
                                }
                                if (event.text == Key.Backspace) {
                                    if (root.handle_backspace()) {
                                        root.move_cursor_to_end();
                                        return accept;
                                    }
                                }
                                if (event.text == Key.Escape) {
                                    if (root.cfg_compact_empty && root.search_text == "" && root.is_expanded) {
                                        root.is_expanded = false;
                                        return accept;
                                    }
                                    root.close_window();
                                    return accept;
                                }
                                if (event.text == Key.Return) {
                                    root.item_activated(root.selected_index);
                                    return accept;
                                }
                                if (event.text == Key.DownArrow) {
                                    if (root.cfg_compact_empty && root.search_text == "" && !root.is_expanded) {
                                        root.is_expanded = true;
                                        return accept;
                                    }
                                    root.move_down();
                                    return accept;
                                }
                                if (event.text == Key.UpArrow) {
                                    if (root.cfg_compact_empty && root.search_text == "" && root.selected_index == 0 && root.is_expanded) {
                                        root.is_expanded = false;
                                        return accept;
                                    }
                                    root.move_up();
                                    return accept;
                                }
                                if (event.modifiers.control && event.text == ",") {
                                    root.open_config();
                                    return accept;
                                }
                                if (event.modifiers.alt && (event.text == "t" || event.text == "T")) {
                                    root.open_in_terminal(root.selected_index);
                                    return accept;
                                }
                                if (event.modifiers.alt && (event.text == "c" || event.text == "C")) {
                                    root.copy_path(root.selected_index);
                                    return accept;
                                }
                                return reject;
                            }
                        }
                    }

                    // 1.3 Right Controls: Minimalist File Indicator + Settings + Close
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 6px;

                            // Show subtle badge ONLY when in specialized mode
                            if (root.mode_badge_text != "") : Rectangle {
                                height: 20px;
                                background: #0a84ff26;
                                border-radius: 4px;

                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    alignment: center;
                                    Text {
                                        text: root.mode_badge_text;
                                        color: #0a84ff;
                                        font-size: 11px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Settings Button (24x24 Square with Centered Icon)
                            settings_btn := Rectangle {
                                width: 24px;
                                height: 24px;
                                background: settings_touch.has-hover ? root.col_btn_secondary_hover : root.col_btn_secondary_bg;
                                border-radius: 6px;
                                animate background { duration: 100ms; }

                                settings_touch := TouchArea {
                                    clicked => {
                                        root.open_config();
                                    }
                                }

                                Image {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    source: root.settings_icon;
                                    width: 14px;
                                    height: 14px;
                                    image-fit: contain;
                                }
                            }

                            // Close Button
                            close_btn := Rectangle {
                                width: 24px;
                                height: 24px;
                                border-radius: 6px;
                                background: close_touch.has-hover ? #ff453a26 : transparent;
                                animate background { duration: 100ms; }

                                close_touch := TouchArea {
                                    clicked => {
                                        root.close_window();
                                    }
                                }

                                Text {
                                    text: "✕";
                                    color: close_touch.has-hover ? #ff453a : root.col_text_muted;
                                    font-size: 11px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // 1.4 Subtle Spotlight Separator Line
            Rectangle {
                visible: root.is_showing_list;
                height: 1px;
                background: root.col_separator;
            }

            // 2. SCROLLABLE RESULTS LIST (macOS Spotlight Item Selection Style)
            list_container := Rectangle {
                visible: root.is_showing_list;
                vertical-stretch: 1;
                clip: true;

                // 2.1 Empty State
                Rectangle {
                    visible: !root.has_results;
                    VerticalLayout {
                        alignment: center;
                        spacing: 8px;
                        HorizontalLayout {
                            alignment: center;
                            Image {
                                source: root.is_empty_folder ? root.folder_icon : root.search_icon;
                                width: 36px;
                                height: 36px;
                                image-fit: contain;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            text: root.empty_state_title;
                            font-size: 14px;
                            font-weight: 600;
                            color: root.col_text_primary;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.empty_state_subtitle;
                            font-size: 12px;
                            color: root.col_text_muted;
                            horizontal-alignment: center;
                        }
                    }
                }

                // 2.2 Scrollable Results
                list_flickable := Flickable {
                    visible: root.has_results;
                    viewport-y <=> root.scroll_viewport_y;
                    viewport-height: root.items.length * 48px;

                    VerticalLayout {
                        spacing: 2px;
                        alignment: start;

                        for item[index] in root.items : item_row := Rectangle {
                            height: 46px;
                            background: (index == root.selected_index) ? root.col_item_selected_bg : (item_touch.has-hover ? root.col_item_hover : transparent);
                            border-radius: 8px;
                            animate background { duration: 80ms; }

                            item_touch := TouchArea {
                                clicked => {
                                    root.selected_index = index;
                                    root.item_activated(index);
                                }
                            }

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 12px;
                                padding-top: 0px;
                                padding-bottom: 0px;
                                spacing: 12px;

                                // Perfectly Vertically-Centered 32px Icon Container
                                VerticalLayout {
                                    alignment: center;
                                    width: 32px;

                                    HorizontalLayout {
                                        alignment: center;

                                        // Real system icon (Freestanding, no box)
                                        if (root.cfg_show_icons && item.has_icon) : Image {
                                            source: item.icon;
                                            width: 30px;
                                            height: 30px;
                                            image-fit: contain;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        // Fallback text/glyph icon (Centered Badge)
                                        if (!root.cfg_show_icons || !item.has_icon) : Rectangle {
                                            width: 28px;
                                            height: 28px;
                                            border-radius: 6px;
                                            background: (index == root.selected_index) ? #ffffff26 : root.col_badge_bg;

                                            Text {
                                                width: 100%;
                                                height: 100%;
                                                text: (item.item_type == "calc") ? "=" : ((item.item_type == "dir") ? "/" : ((item.item_type == "clip") ? "≡" : ((item.item_type == "win") ? "□" : ((item.item_type == "sys") ? "⚙" : ((item.item_type == "theme") ? "◐" : "◆")))));
                                                color: (index == root.selected_index) ? #ffffff : root.col_badge_text;
                                                font-size: 15px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                // Item Name Title (Razor-sharp high contrast text)
                                Text {
                                    text: item.name;
                                    color: (index == root.selected_index) ? #ffffff : root.col_text_primary;
                                    font-weight: (index == root.selected_index) ? 600 : 500;
                                    font-size: 15px;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                // Category / Type Label (High contrast secondary text)
                                HorizontalLayout {
                                    alignment: end;
                                    Text {
                                        text: item.category;
                                        color: (index == root.selected_index) ? #ffffffcc : root.col_text_muted;
                                        font-size: 12px;
                                        font-weight: 500;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // 3. KEYBOARD SHORTCUTS FOOTER BAR (Raycast Minimalist Action Bar)
            if (root.cfg_show_status_bar && root.is_showing_list) : footer := Rectangle {
                height: 24px;

                property <string> sel_type: (root.items.length > root.selected_index && root.selected_index >= 0) ? root.items[root.selected_index].item_type : "";

                HorizontalLayout {
                    alignment: space-between;

                    // Left: Contextual Keyboard Affordance Hints
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;

                        // Open (Return Key)
                        HorizontalLayout {
                            spacing: 5px;
                            alignment: center;

                            Rectangle {
                                background: root.col_kbd_bg;
                                border-radius: 4px;
                                height: 18px;
                                width: 22px;
                                border-width: 1px;
                                border-color: root.col_kbd_border;
                                HorizontalLayout {
                                    alignment: center;
                                    Image {
                                        source: root.enter_icon;
                                        width: 11px;
                                        height: 11px;
                                        image-fit: contain;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                            Text {
                                text: (footer.sel_type == "calc" || footer.sel_type == "clip") ? "Copy" : ((footer.sel_type == "win") ? "Switch" : ((footer.sel_type == "sys" || footer.sel_type == "theme") ? "Apply" : "Open"));
                                color: root.col_kbd_text;
                                font-size: 11px;
                                font-weight: 500;
                                vertical-alignment: center;
                            }
                        }

                        // Tab In (Browse Folder)
                        if (footer.sel_type == "dir") : HorizontalLayout {
                            spacing: 5px;
                            alignment: center;

                            Rectangle {
                                background: root.col_kbd_bg;
                                border-radius: 4px;
                                height: 18px;
                                border-width: 1px;
                                border-color: root.col_kbd_border;
                                HorizontalLayout {
                                    padding-left: 5px;
                                    padding-right: 5px;
                                    alignment: center;
                                    Text { text: "Tab"; color: root.col_kbd_accent; font-weight: 700; font-size: 10px; vertical-alignment: center; }
                                }
                            }
                            Text { text: "Browse"; color: root.col_kbd_text; font-size: 11px; font-weight: 500; vertical-alignment: center; }
                        }

                        // Copy Path (Alt+C)
                        if (footer.sel_type == "file" || footer.sel_type == "dir") : HorizontalLayout {
                            spacing: 5px;
                            alignment: center;

                            Rectangle {
                                background: root.col_kbd_bg;
                                border-radius: 4px;
                                height: 18px;
                                border-width: 1px;
                                border-color: root.col_kbd_border;
                                HorizontalLayout {
                                    padding-left: 5px;
                                    padding-right: 5px;
                                    alignment: center;
                                    Text { text: "Alt+C"; color: root.col_kbd_text; font-weight: 700; font-size: 10px; vertical-alignment: center; }
                                }
                            }
                            Text { text: "Copy Path"; color: root.col_kbd_text; font-size: 11px; font-weight: 500; vertical-alignment: center; }
                        }

                        // Terminal (Alt+T)
                        if (footer.sel_type == "file" || footer.sel_type == "dir") : HorizontalLayout {
                            spacing: 5px;
                            alignment: center;

                            Rectangle {
                                background: root.col_kbd_bg;
                                border-radius: 4px;
                                height: 18px;
                                border-width: 1px;
                                border-color: root.col_kbd_border;
                                HorizontalLayout {
                                    padding-left: 5px;
                                    padding-right: 5px;
                                    alignment: center;
                                    Text { text: "Alt+T"; color: root.col_kbd_text; font-weight: 700; font-size: 10px; vertical-alignment: center; }
                                }
                            }
                            Text { text: "Terminal"; color: root.col_kbd_text; font-size: 11px; font-weight: 500; vertical-alignment: center; }
                        }

                        // Ctrl+, Settings
                        HorizontalLayout {
                            spacing: 5px;
                            alignment: center;

                            Rectangle {
                                background: root.col_kbd_bg;
                                border-radius: 4px;
                                height: 18px;
                                border-width: 1px;
                                border-color: root.col_kbd_border;
                                HorizontalLayout {
                                    padding-left: 5px;
                                    padding-right: 5px;
                                    alignment: center;
                                    Text { text: "Ctrl+,"; color: root.col_kbd_accent; font-weight: 700; font-size: 10px; vertical-alignment: center; }
                                }
                            }
                            Text { text: "Settings"; color: root.col_kbd_text; font-size: 11px; font-weight: 500; vertical-alignment: center; }
                        }
                    }

                    // Right: Item Count
                    HorizontalLayout {
                        alignment: end;
                        Text {
                            text: root.status_item_count;
                            color: root.col_text_muted;
                            font-size: 11px;
                            font-weight: 500;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // =========================================================
        // VIEW 2: SPOTLIGHT PREFERENCES VIEW
        // =========================================================
        settings_view := Rectangle {
            visible: root.in_settings_mode;
            width: 100%;
            height: 100%;

            settings_focus := FocusScope {
                width: 100%;
                height: 100%;

                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.close_settings();
                        return accept;
                    }
                    return reject;
                }

                VerticalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 14px;
                    padding-bottom: 16px;
                    spacing: 10px;

                    // 0. Settings Header Bar (26px)
                    settings_title_bar := Rectangle {
                        height: 26px;

                        settings_drag_region := TouchArea {
                            width: 100%;
                            height: 100%;
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                    root.start_window_drag();
                                }
                            }
                        }

                        HorizontalLayout {
                            alignment: space-between;

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                HorizontalLayout {
                                    alignment: center;
                                    width: 18px;
                                    Image {
                                        source: root.settings_icon;
                                        width: 16px;
                                        height: 16px;
                                        image-fit: contain;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }
                                }
                                Text {
                                    text: "Spotlight Preferences";
                                    color: root.col_text_primary;
                                    font-size: 14px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }

                            // Back Button [Esc]
                            back_btn := Rectangle {
                                height: 26px;
                                background: back_touch.has-hover ? root.col_btn_secondary_hover : root.col_btn_secondary_bg;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: root.col_settings_card_border;

                                back_touch := TouchArea {
                                    clicked => {
                                        root.close_settings();
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: center;
                                    Text {
                                        text: "← Back [Esc]";
                                        color: root.col_btn_secondary_text;
                                        font-size: 11px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: root.col_separator; }

                    // 1. Settings Content Area
                    VerticalLayout {
                        vertical-stretch: 1;
                        spacing: 7px;

                        // Group 0: System & Startup
                        Text {
                            text: "SYSTEM & STARTUP";
                            color: root.col_kbd_accent;
                            font-size: 11px;
                            font-weight: 700;
                        }

                        // Setting: Autostart with System
                        Rectangle {
                            height: 36px;
                            background: root.col_settings_card_bg;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: root.col_settings_card_border;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: space-between;
                                Text {
                                    text: "Start Automatically on System Boot";
                                    color: root.col_settings_card_text;
                                    font-size: 13px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                                toggle_autostart := Rectangle {
                                    width: 48px;
                                    height: 22px;
                                    border-radius: 11px;
                                    background: root.cfg_autostart ? #34c759 : #3a3a3c;
                                    TouchArea {
                                        clicked => {
                                            root.cfg_autostart = !root.cfg_autostart;
                                        }
                                    }
                                    Text {
                                        width: 100%;
                                        height: 100%;
                                        text: root.cfg_autostart ? "ON" : "OFF";
                                        color: root.cfg_autostart ? #ffffff : #8e8e93;
                                        font-size: 10px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }

                        // Group 1: Appearance & Theme
                        Text {
                            text: "APPEARANCE & THEME";
                            color: root.col_kbd_accent;
                            font-size: 11px;
                            font-weight: 700;
                        }

                        // Setting: Theme Mode (Dark / Light / System)
                        Rectangle {
                            height: 36px;
                            background: root.col_settings_card_bg;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: root.col_settings_card_border;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: space-between;
                                Text {
                                    text: "Theme Palette";
                                    color: root.col_settings_card_text;
                                    font-size: 13px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    width: 176px;
                                    height: 26px;
                                    background: root.col_kbd_bg;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: root.col_settings_card_border;
                                    HorizontalLayout {
                                        padding: 2px;
                                        spacing: 2px;

                                        // Dark
                                        Rectangle {
                                            width: 56px;
                                            height: 22px;
                                            border-radius: 4px;
                                            background: (root.cfg_theme_mode == "dark") ? #007aff : transparent;
                                            TouchArea {
                                                clicked => {
                                                    root.cfg_theme_mode = "dark";
                                                    root.is_dark = true;
                                                }
                                            }
                                            Text {
                                                text: "Dark";
                                                color: (root.cfg_theme_mode == "dark") ? #ffffff : root.col_text_muted;
                                                font-size: 11px;
                                                font-weight: (root.cfg_theme_mode == "dark") ? 700 : 500;
                                                vertical-alignment: center;
                                                horizontal-alignment: center;
                                            }
                                        }

                                        // Light
                                        Rectangle {
                                            width: 56px;
                                            height: 22px;
                                            border-radius: 4px;
                                            background: (root.cfg_theme_mode == "light") ? #007aff : transparent;
                                            TouchArea {
                                                clicked => {
                                                    root.cfg_theme_mode = "light";
                                                    root.is_dark = false;
                                                }
                                            }
                                            Text {
                                                text: "Light";
                                                color: (root.cfg_theme_mode == "light") ? #ffffff : root.col_text_muted;
                                                font-size: 11px;
                                                font-weight: (root.cfg_theme_mode == "light") ? 700 : 500;
                                                vertical-alignment: center;
                                                horizontal-alignment: center;
                                            }
                                        }

                                        // System
                                        Rectangle {
                                            width: 56px;
                                            height: 22px;
                                            border-radius: 4px;
                                            background: (root.cfg_theme_mode == "system") ? #007aff : transparent;
                                            TouchArea {
                                                clicked => {
                                                    root.cfg_theme_mode = "system";
                                                }
                                            }
                                            Text {
                                                text: "System";
                                                color: (root.cfg_theme_mode == "system") ? #ffffff : root.col_text_muted;
                                                font-size: 11px;
                                                font-weight: (root.cfg_theme_mode == "system") ? 700 : 500;
                                                vertical-alignment: center;
                                                horizontal-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Setting: Window Opacity Selector
                        Rectangle {
                            height: 36px;
                            background: root.col_settings_card_bg;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: root.col_settings_card_border;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: space-between;
                                Text {
                                    text: "Window Opacity (Glassmorphism)";
                                    color: root.col_settings_card_text;
                                    font-size: 13px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    width: 222px;
                                    height: 26px;
                                    background: root.col_kbd_bg;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: root.col_settings_card_border;
                                    HorizontalLayout {
                                        padding: 2px;
                                        spacing: 2px;

                                        // 100%
                                        Rectangle {
                                            width: 42px;
                                            height: 22px;
                                            border-radius: 4px;
                                            background: (root.cfg_theme_opacity >= 0.98) ? #007aff : transparent;
                                            TouchArea { clicked => { root.cfg_theme_opacity = 1.0; } }
                                            Text { text: "100%"; color: (root.cfg_theme_opacity >= 0.98) ? #ffffff : root.col_text_muted; font-size: 11px; font-weight: (root.cfg_theme_opacity >= 0.98) ? 700 : 500; vertical-alignment: center; horizontal-alignment: center; }
                                        }

                                        // 95%
                                        Rectangle {
                                            width: 42px;
                                            height: 22px;
                                            border-radius: 4px;
                                            background: (root.cfg_theme_opacity >= 0.93 && root.cfg_theme_opacity < 0.98) ? #007aff : transparent;
                                            TouchArea { clicked => { root.cfg_theme_opacity = 0.95; } }
                                            Text { text: "95%"; color: (root.cfg_theme_opacity >= 0.93 && root.cfg_theme_opacity < 0.98) ? #ffffff : root.col_text_muted; font-size: 11px; font-weight: (root.cfg_theme_opacity >= 0.93 && root.cfg_theme_opacity < 0.98) ? 700 : 500; vertical-alignment: center; horizontal-alignment: center; }
                                        }

                                        // 90%
                                        Rectangle {
                                            width: 42px;
                                            height: 22px;
                                            border-radius: 4px;
                                            background: (root.cfg_theme_opacity >= 0.86 && root.cfg_theme_opacity < 0.93) ? #007aff : transparent;
                                            TouchArea { clicked => { root.cfg_theme_opacity = 0.90; } }
                                            Text { text: "90%"; color: (root.cfg_theme_opacity >= 0.86 && root.cfg_theme_opacity < 0.93) ? #ffffff : root.col_text_muted; font-size: 11px; font-weight: (root.cfg_theme_opacity >= 0.86 && root.cfg_theme_opacity < 0.93) ? 700 : 500; vertical-alignment: center; horizontal-alignment: center; }
                                        }

                                        // 80%
                                        Rectangle {
                                            width: 42px;
                                            height: 22px;
                                            border-radius: 4px;
                                            background: (root.cfg_theme_opacity >= 0.76 && root.cfg_theme_opacity < 0.86) ? #007aff : transparent;
                                            TouchArea { clicked => { root.cfg_theme_opacity = 0.80; } }
                                            Text { text: "80%"; color: (root.cfg_theme_opacity >= 0.76 && root.cfg_theme_opacity < 0.86) ? #ffffff : root.col_text_muted; font-size: 11px; font-weight: (root.cfg_theme_opacity >= 0.76 && root.cfg_theme_opacity < 0.86) ? 700 : 500; vertical-alignment: center; horizontal-alignment: center; }
                                        }

                                        // 70%
                                        Rectangle {
                                            width: 42px;
                                            height: 22px;
                                            border-radius: 4px;
                                            background: (root.cfg_theme_opacity < 0.76) ? #007aff : transparent;
                                            TouchArea { clicked => { root.cfg_theme_opacity = 0.70; } }
                                            Text { text: "70%"; color: (root.cfg_theme_opacity < 0.76) ? #ffffff : root.col_text_muted; font-size: 11px; font-weight: (root.cfg_theme_opacity < 0.76) ? 700 : 500; vertical-alignment: center; horizontal-alignment: center; }
                                        }
                                    }
                                }
                            }
                        }

                        // Setting: Show App Icons
                        Rectangle {
                            height: 36px;
                            background: root.col_settings_card_bg;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: root.col_settings_card_border;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: space-between;
                                Text {
                                    text: "Show Native Application Icons";
                                    color: root.col_settings_card_text;
                                    font-size: 13px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                                toggle_icon := Rectangle {
                                    width: 48px;
                                    height: 22px;
                                    border-radius: 11px;
                                    background: root.cfg_show_icons ? #34c759 : #3a3a3c;
                                    TouchArea {
                                        clicked => {
                                            root.cfg_show_icons = !root.cfg_show_icons;
                                        }
                                    }
                                    Text {
                                        width: 100%;
                                        height: 100%;
                                        text: root.cfg_show_icons ? "ON" : "OFF";
                                        color: root.cfg_show_icons ? #ffffff : #8e8e93;
                                        font-size: 10px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }

                        // Setting: Compact Start View
                        Rectangle {
                            height: 36px;
                            background: root.col_settings_card_bg;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: root.col_settings_card_border;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: space-between;
                                Text {
                                    text: "Compact Start View (Spotlight bar)";
                                    color: root.col_settings_card_text;
                                    font-size: 13px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                                toggle_compact := Rectangle {
                                    width: 48px;
                                    height: 22px;
                                    border-radius: 11px;
                                    background: root.cfg_compact_empty ? #34c759 : #3a3a3c;
                                    TouchArea {
                                        clicked => {
                                            root.cfg_compact_empty = !root.cfg_compact_empty;
                                        }
                                    }
                                    Text {
                                        width: 100%;
                                        height: 100%;
                                        text: root.cfg_compact_empty ? "ON" : "OFF";
                                        color: root.cfg_compact_empty ? #ffffff : #8e8e93;
                                        font-size: 10px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }

                        // Setting: Show Status Bar
                        Rectangle {
                            height: 36px;
                            background: root.col_settings_card_bg;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: root.col_settings_card_border;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: space-between;
                                Text {
                                    text: "Show Bottom Keyboard Shortcuts Bar";
                                    color: root.col_settings_card_text;
                                    font-size: 13px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                                toggle_bar := Rectangle {
                                    width: 48px;
                                    height: 22px;
                                    border-radius: 11px;
                                    background: root.cfg_show_status_bar ? #34c759 : #3a3a3c;
                                    TouchArea {
                                        clicked => {
                                            root.cfg_show_status_bar = !root.cfg_show_status_bar;
                                        }
                                    }
                                    Text {
                                        width: 100%;
                                        height: 100%;
                                        text: root.cfg_show_status_bar ? "ON" : "OFF";
                                        color: root.cfg_show_status_bar ? #ffffff : #8e8e93;
                                        font-size: 10px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }

                        // Group 2: Search Engine
                        Text {
                            text: "SEARCH & ENGINE";
                            color: root.col_kbd_accent;
                            font-size: 11px;
                            font-weight: 700;
                        }

                        // Setting: Match Full Path
                        Rectangle {
                            height: 36px;
                            background: root.col_settings_card_bg;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: root.col_settings_card_border;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: space-between;
                                Text {
                                    text: "Match Full File & Directory Paths";
                                    color: root.col_settings_card_text;
                                    font-size: 13px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                                toggle_path := Rectangle {
                                    width: 48px;
                                    height: 22px;
                                    border-radius: 11px;
                                    background: root.cfg_enable_path_matching ? #34c759 : #3a3a3c;
                                    TouchArea {
                                        clicked => {
                                            root.cfg_enable_path_matching = !root.cfg_enable_path_matching;
                                        }
                                    }
                                    Text {
                                        width: 100%;
                                        height: 100%;
                                        text: root.cfg_enable_path_matching ? "ON" : "OFF";
                                        color: root.cfg_enable_path_matching ? #ffffff : #8e8e93;
                                        font-size: 10px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }

                        // Setting: Max Results Selector
                        Rectangle {
                            height: 36px;
                            background: root.col_settings_card_bg;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: root.col_settings_card_border;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: space-between;
                                Text {
                                    text: "Max Visible Search Results";
                                    color: root.col_settings_card_text;
                                    font-size: 13px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    width: 104px;
                                    height: 26px;
                                    background: root.col_kbd_bg;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: root.col_settings_card_border;
                                    HorizontalLayout {
                                        padding: 2px;
                                        spacing: 2px;

                                        for num in [5, 7, 9] : Rectangle {
                                            width: 32px;
                                            height: 22px;
                                            border-radius: 4px;
                                            background: (root.cfg_max_results == num) ? #007aff : transparent;
                                            TouchArea {
                                                clicked => {
                                                    root.cfg_max_results = num;
                                                }
                                            }
                                            Text {
                                                text: "\{num}";
                                                color: (root.cfg_max_results == num) ? #ffffff : root.col_text_muted;
                                                font-size: 11px;
                                                font-weight: (root.cfg_max_results == num) ? 700 : 500;
                                                vertical-alignment: center;
                                                horizontal-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // 2. Status Toast Notification
                    if root.settings_status != "" : Text {
                        text: root.settings_status;
                        color: #34c759;
                        font-size: 12px;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }

                    Rectangle { height: 1px; background: root.col_separator; }

                    // 3. Action Buttons
                    HorizontalLayout {
                        height: 32px;
                        spacing: 10px;
                        alignment: end;

                        // Button: Open Raw config.toml
                        raw_btn := Rectangle {
                            background: raw_touch.has-hover ? root.col_btn_secondary_hover : root.col_btn_secondary_bg;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: root.col_settings_card_border;

                            raw_touch := TouchArea {
                                clicked => {
                                    root.open_raw_config();
                                }
                            }

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: center;
                                Text {
                                    text: "Edit config.toml";
                                    color: root.col_btn_secondary_text;
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Button: Save & Apply
                        save_btn := Rectangle {
                            background: save_touch.has-hover ? #0062d2 : #007aff;
                            border-radius: 6px;

                            save_touch := TouchArea {
                                clicked => {
                                    root.save_settings(
                                        root.cfg_show_icons,
                                        root.cfg_show_status_bar,
                                        root.cfg_enable_path_matching,
                                        root.cfg_max_results,
                                        root.cfg_max_depth,
                                        root.cfg_autostart,
                                        root.cfg_compact_empty,
                                        root.cfg_theme_mode,
                                        root.cfg_theme_opacity
                                    );
                                }
                            }

                            HorizontalLayout {
                                padding-left: 18px;
                                padding-right: 18px;
                                alignment: center;
                                Text {
                                    text: "Save & Apply";
                                    color: #ffffff;
                                    font-size: 12px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
