export struct LauncherItemData {
    name: string,
    category: string,
    item_type: string,
    has_icon: bool,
    icon: image,
    exec_or_path: string,
}

export component AppWindow inherits Window {
    title: "View Launcher";
    no-frame: true;
    background: transparent;
    width: 680px;
    height: 490px;

    in-out property <string> search_text: "";
    in-out property <int> selected_index: 0;
    in property <[LauncherItemData]> items: [];
    in property <bool> has_results: true;
    in property <string> mode_title: "APPLICATIONS";
    in property <string> mode_icon: "󰀻";
    in property <bool> is_file_mode: false;
    in property <string> status_item_count: "0 apps";

    // In-App Settings State
    in-out property <bool> in_settings_mode: false;
    in-out property <bool> cfg_show_icons: true;
    in-out property <bool> cfg_show_status_bar: true;
    in-out property <bool> cfg_enable_path_matching: true;
    in-out property <int> cfg_max_results: 8;
    in-out property <int> cfg_max_depth: 2;
    in-out property <string> settings_status: "";

    callback search_text_changed(string);
    callback move_up();
    callback move_down();
    callback item_activated(int);
    callback open_in_terminal(int);
    callback copy_path(int);
    callback open_config();
    callback close_settings();
    callback save_settings(bool, bool, bool, int, int);
    callback open_raw_config();
    callback close_window();
    callback start_window_drag();

    forward-focus: search_input;

    init => {
        search_input.focus();
    }

    // Main Outer Container (Spotlight / Raycast Floating Card)
    main_card := Rectangle {
        width: 100%;
        height: 100%;
        background: #16161e;
        border-radius: 16px;
        border-width: 1px;
        border-color: #2e344f;
        clip: true;

        // =========================================================
        // VIEW 1: SPOTLIGHT SEARCH & LAUNCHER VIEW
        // =========================================================
        search_view := VerticalLayout {
            visible: !root.in_settings_mode;
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 14px;
            padding-bottom: 12px;
            spacing: 12px;

            // 1. Top Spotlight Search Bar with integrated Header Drag Area
            search_box := Rectangle {
                height: 52px;
                background: #1f2335;
                border-radius: 12px;
                border-width: 1.5px;
                border-color: root.is_file_mode ? #2ac3de : (search_input.has-focus ? #7aa2f7 : #3b4261);

                TouchArea {
                    clicked => {
                        search_input.focus();
                    }
                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            root.start_window_drag();
                        }
                    }
                }

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 14px;
                    spacing: 12px;

                    // Mode Icon (Lens for App, Folder for File, Calc for Math)
                    Text {
                        text: root.is_file_mode ? "󰉋" : "󰍉";
                        color: root.is_file_mode ? #2ac3de : #7dcfff;
                        font-size: 20px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    // Text Input Area with smooth placeholder
                    Rectangle {
                        horizontal-stretch: 1;

                        Text {
                            text: root.is_file_mode ? "Search files & folders (e.g. notes.pdf, ~/Projects)..." : "Search apps, type @f for files, or 500*12...";
                            color: #565f89;
                            font-size: 15px;
                            font-italic: true;
                            vertical-alignment: center;
                            visible: root.search_text == "";
                        }

                        search_input := TextInput {
                            text: root.search_text;
                            single-line: true;
                            font-size: 15px;
                            color: #ffffff;
                            selection-background-color: #3d59a1;
                            selection-foreground-color: #ffffff;
                            vertical-alignment: center;

                            edited => {
                                root.search_text = self.text;
                                root.search_text_changed(self.text);
                            }

                            key-pressed(event) => {
                                if (event.text == Key.Escape) {
                                    if (root.in_settings_mode) {
                                        root.close_settings();
                                        return accept;
                                    }
                                    root.close_window();
                                    return accept;
                                }
                                if (event.text == Key.Return) {
                                    root.item_activated(root.selected_index);
                                    return accept;
                                }
                                if (event.text == Key.DownArrow) {
                                    root.move_down();
                                    return accept;
                                }
                                if (event.text == Key.UpArrow) {
                                    root.move_up();
                                    return accept;
                                }
                                if (event.modifiers.control && event.text == ",") {
                                    root.open_config();
                                    return accept;
                                }
                                if (event.modifiers.alt && (event.text == "t" || event.text == "T")) {
                                    root.open_in_terminal(root.selected_index);
                                    return accept;
                                }
                                if (event.modifiers.alt && (event.text == "c" || event.text == "C")) {
                                    root.copy_path(root.selected_index);
                                    return accept;
                                }
                                return reject;
                            }
                        }
                    }

                    // Mode Badge Pill & Settings Quick Button
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        // Mode tag
                        Rectangle {
                            height: 24px;
                            background: root.is_file_mode ? #163642 : #1c2541;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: root.is_file_mode ? #2ac3de : #7aa2f7;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text {
                                    text: root.mode_title;
                                    color: root.is_file_mode ? #2ac3de : #7aa2f7;
                                    font-size: 10px;
                                    font-weight: 800;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Settings Icon Button
                        settings_btn := Rectangle {
                            width: 26px;
                            height: 26px;
                            border-radius: 6px;
                            background: settings_touch.has-hover ? #2e344f : #1a1b26;
                            border-width: 1px;
                            border-color: #2e344f;

                            settings_touch := TouchArea {
                                clicked => {
                                    root.open_config();
                                }
                            }

                            Text {
                                text: "⚙";
                                color: settings_touch.has-hover ? #7dcfff : #7aa2f7;
                                font-size: 14px;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }

            // 2. Item Results List (Direct Static Layout - Instant, No Lag)
            list_container := Rectangle {
                vertical-stretch: 1;
                clip: true;

                // Empty State when no results found
                Rectangle {
                    visible: !root.has_results;
                    VerticalLayout {
                        alignment: center;
                        spacing: 10px;
                        Text {
                            text: "󰋔";
                            font-size: 36px;
                            color: #3b4261;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "No matching applications, files, or calculations found.";
                            font-size: 13px;
                            color: #565f89;
                            horizontal-alignment: center;
                        }
                    }
                }

                // Results List
                VerticalLayout {
                    visible: root.has_results;
                    alignment: start;
                    spacing: 4px;

                    for item[index] in root.items : item_row := Rectangle {
                        height: 42px;
                        background: (index == root.selected_index) ? #242b48 : (item_touch.has-hover ? #1c2033 : transparent);
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: (index == root.selected_index) ? #3d59a1 : transparent;

                        item_touch := TouchArea {
                            clicked => {
                                root.selected_index = index;
                                root.item_activated(index);
                            }
                        }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 14px;
                            spacing: 12px;

                            // Left Side: Selection Indicator + Icon + Item Title
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                horizontal-stretch: 1;

                                // Selection Indicator Neon Pill
                                HorizontalLayout {
                                    alignment: center;
                                    width: 3px;
                                    Rectangle {
                                        width: 3px;
                                        height: 20px;
                                        border-radius: 2px;
                                        background: (index == root.selected_index) ? #7dcfff : transparent;
                                    }
                                }

                                // Native System App Icon (26x26)
                                if (root.cfg_show_icons && item.has_icon) : HorizontalLayout {
                                    alignment: center;
                                    width: 26px;
                                    Image {
                                        source: item.icon;
                                        width: 26px;
                                        height: 26px;
                                        image-fit: contain;
                                    }
                                }

                                // High-Contrast Fallback Icon
                                if (!root.cfg_show_icons || !item.has_icon) : Text {
                                    text: (item.item_type == "dir") ? "" : (item.item_type == "calc" ? "󰃬" : "󰀻");
                                    color: (item.item_type == "calc") ? #9ece6a : (item.item_type == "dir" ? #2ac3de : #7aa2f7);
                                    font-size: 18px;
                                    vertical-alignment: center;
                                }

                                // App Name with Bold Contrast
                                Text {
                                    text: item.name;
                                    color: (index == root.selected_index) ? #ffffff : #c0caf5;
                                    font-weight: (index == root.selected_index) ? 700 : 500;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }

                            // Right Side: Category Pill Badge
                            HorizontalLayout {
                                alignment: end;
                                Rectangle {
                                    background: (index == root.selected_index) ? #1c2033 : #1a1b26;
                                    border-radius: 6px;
                                    height: 22px;
                                    border-width: 1px;
                                    border-color: (index == root.selected_index) ? #3d59a1 : #24283b;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: item.category;
                                            color: (index == root.selected_index) ? #7dcfff : #7aa2f7;
                                            font-size: 11px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Divider line above footer
            Rectangle {
                height: 1px;
                background: #24283b;
            }

            // 3. Modern Keycap Footer Bar
            if root.cfg_show_status_bar : footer := Rectangle {
                height: 28px;

                HorizontalLayout {
                    alignment: space-between;

                    // Left Shortcuts with Keycap Badges
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;

                        // [↵ Open]
                        HorizontalLayout {
                            spacing: 4px;
                            Rectangle {
                                background: #24283b;
                                border-radius: 4px;
                                height: 20px;
                                border-width: 1px;
                                border-color: #3b4261;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    Text { text: "↵"; color: #7aa2f7; font-weight: 800; font-size: 11px; vertical-alignment: center; }
                                }
                            }
                            Text { text: "Open"; color: #787c99; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                        }

                        // [Alt+T Terminal]
                        HorizontalLayout {
                            spacing: 4px;
                            Rectangle {
                                background: #24283b;
                                border-radius: 4px;
                                height: 20px;
                                border-width: 1px;
                                border-color: #3b4261;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    Text { text: "Alt+T"; color: #7aa2f7; font-weight: 800; font-size: 11px; vertical-alignment: center; }
                                }
                            }
                            Text { text: "Terminal"; color: #787c99; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                        }

                        // [Alt+C Copy]
                        HorizontalLayout {
                            spacing: 4px;
                            Rectangle {
                                background: #24283b;
                                border-radius: 4px;
                                height: 20px;
                                border-width: 1px;
                                border-color: #3b4261;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    Text { text: "Alt+C"; color: #7aa2f7; font-weight: 800; font-size: 11px; vertical-alignment: center; }
                                }
                            }
                            Text { text: "Copy Path"; color: #787c99; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                        }

                        // [Ctrl+, Config]
                        HorizontalLayout {
                            spacing: 4px;
                            Rectangle {
                                background: #24283b;
                                border-radius: 4px;
                                height: 20px;
                                border-width: 1px;
                                border-color: #3b4261;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    Text { text: "Ctrl+,"; color: #7aa2f7; font-weight: 800; font-size: 11px; vertical-alignment: center; }
                                }
                            }
                            Text { text: "Settings"; color: #787c99; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                        }
                    }

                    // Right Item Count & [Esc Quit]
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: end;

                        Text {
                            text: root.status_item_count;
                            color: #565f89;
                            font-size: 11px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        HorizontalLayout {
                            spacing: 4px;
                            Rectangle {
                                background: #24283b;
                                border-radius: 4px;
                                height: 20px;
                                border-width: 1px;
                                border-color: #3b4261;
                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    Text { text: "Esc"; color: #f7768e; font-weight: 800; font-size: 11px; vertical-alignment: center; }
                                }
                            }
                            Text { text: "Quit"; color: #787c99; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                        }
                    }
                }
            }
        }

        // =========================================================
        // VIEW 2: IN-APP GUI SETTINGS & CONFIG VIEW
        // =========================================================
        settings_view := VerticalLayout {
            visible: root.in_settings_mode;
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 16px;
            padding-bottom: 16px;
            spacing: 14px;

            // 1. Settings Header Bar
            HorizontalLayout {
                height: 32px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    Text {
                        text: "⚙";
                        color: #7aa2f7;
                        font-size: 18px;
                        font-weight: 800;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "VIEW LAUNCHER PREFERENCES";
                        color: #ffffff;
                        font-size: 14px;
                        font-weight: 800;
                        vertical-alignment: center;
                    }
                }

                // Back Button [Esc]
                back_btn := Rectangle {
                    height: 28px;
                    background: back_touch.has-hover ? #2e344f : #1f2335;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #3b4261;

                    back_touch := TouchArea {
                        clicked => {
                            root.close_settings();
                        }
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 6px;
                        Text {
                            text: "← Back [Esc]";
                            color: #c0caf5;
                            font-size: 12px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: #24283b; }

            // 2. Settings Content Area
            VerticalLayout {
                vertical-stretch: 1;
                spacing: 10px;

                // Group 1: Appearance
                Text {
                    text: "APPEARANCE & VISUALS";
                    color: #7aa2f7;
                    font-size: 11px;
                    font-weight: 800;
                }

                // Setting: Show App Icons
                Rectangle {
                    height: 40px;
                    background: #1f2335;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #2e344f;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        alignment: space-between;
                        Text {
                            text: "Show Native High-Res Application Icons";
                            color: #c0caf5;
                            font-size: 13px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        toggle_icon := Rectangle {
                            width: 64px;
                            height: 26px;
                            border-radius: 13px;
                            background: root.cfg_show_icons ? #7aa2f7 : #3b4261;
                            TouchArea {
                                clicked => {
                                    root.cfg_show_icons = !root.cfg_show_icons;
                                }
                            }
                            Text {
                                text: root.cfg_show_icons ? "ON" : "OFF";
                                color: root.cfg_show_icons ? #16161e : #a9b1d6;
                                font-size: 11px;
                                font-weight: 800;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Setting: Show Status Bar
                Rectangle {
                    height: 40px;
                    background: #1f2335;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #2e344f;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        alignment: space-between;
                        Text {
                            text: "Show Bottom Keyboard Shortcuts Bar";
                            color: #c0caf5;
                            font-size: 13px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        toggle_bar := Rectangle {
                            width: 64px;
                            height: 26px;
                            border-radius: 13px;
                            background: root.cfg_show_status_bar ? #7aa2f7 : #3b4261;
                            TouchArea {
                                clicked => {
                                    root.cfg_show_status_bar = !root.cfg_show_status_bar;
                                }
                            }
                            Text {
                                text: root.cfg_show_status_bar ? "ON" : "OFF";
                                color: root.cfg_show_status_bar ? #16161e : #a9b1d6;
                                font-size: 11px;
                                font-weight: 800;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Group 2: Search Engine
                Text {
                    text: "SEARCH & PERFORMANCE";
                    color: #7aa2f7;
                    font-size: 11px;
                    font-weight: 800;
                }

                // Setting: Match Full Path
                Rectangle {
                    height: 40px;
                    background: #1f2335;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #2e344f;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        alignment: space-between;
                        Text {
                            text: "Match Full File & Directory Paths";
                            color: #c0caf5;
                            font-size: 13px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        toggle_path := Rectangle {
                            width: 64px;
                            height: 26px;
                            border-radius: 13px;
                            background: root.cfg_enable_path_matching ? #2ac3de : #3b4261;
                            TouchArea {
                                clicked => {
                                    root.cfg_enable_path_matching = !root.cfg_enable_path_matching;
                                }
                            }
                            Text {
                                text: root.cfg_enable_path_matching ? "ON" : "OFF";
                                color: root.cfg_enable_path_matching ? #16161e : #a9b1d6;
                                font-size: 11px;
                                font-weight: 800;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Setting: Max Results Selector
                Rectangle {
                    height: 40px;
                    background: #1f2335;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #2e344f;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        alignment: space-between;
                        Text {
                            text: "Max Visible Search Results";
                            color: #c0caf5;
                            font-size: 13px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: end;

                            for num in [6, 8, 10, 12] : Rectangle {
                                width: 36px;
                                height: 26px;
                                border-radius: 6px;
                                background: (root.cfg_max_results == num) ? #7aa2f7 : #16161e;
                                border-width: 1px;
                                border-color: (root.cfg_max_results == num) ? #7aa2f7 : #3b4261;
                                TouchArea {
                                    clicked => {
                                        root.cfg_max_results = num;
                                    }
                                }
                                Text {
                                    text: "\{num}";
                                    color: (root.cfg_max_results == num) ? #16161e : #c0caf5;
                                    font-size: 12px;
                                    font-weight: 800;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // 3. Status Toast Notification
            if root.settings_status != "" : Text {
                text: root.settings_status;
                color: #9ece6a;
                font-size: 12px;
                font-weight: 700;
                horizontal-alignment: center;
            }

            Rectangle { height: 1px; background: #24283b; }

            // 4. Action Buttons
            HorizontalLayout {
                height: 38px;
                spacing: 12px;
                alignment: end;

                // Button: Open Raw config.toml
                raw_btn := Rectangle {
                    background: raw_touch.has-hover ? #2e344f : #1f2335;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #3b4261;

                    raw_touch := TouchArea {
                        clicked => {
                            root.open_raw_config();
                        }
                    }

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        Text {
                            text: "📝 Edit config.toml";
                            color: #c0caf5;
                            font-size: 12px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }

                // Button: Save & Apply
                save_btn := Rectangle {
                    background: save_touch.has-hover ? #9ece6a : #7aa2f7;
                    border-radius: 8px;

                    save_touch := TouchArea {
                        clicked => {
                            root.save_settings(
                                root.cfg_show_icons,
                                root.cfg_show_status_bar,
                                root.cfg_enable_path_matching,
                                root.cfg_max_results,
                                root.cfg_max_depth
                            );
                        }
                    }

                    HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        Text {
                            text: "💾 Save & Apply Changes";
                            color: #16161e;
                            font-size: 13px;
                            font-weight: 800;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
