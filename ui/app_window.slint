export struct LauncherItemData {
    name: string,
    category: string,
    item_type: string,
    has_icon: bool,
    icon: image,
    exec_or_path: string,
}

export component AppWindow inherits Window {
    title: "View Launcher";
    no-frame: true;
    background: transparent;
    width: 680px;
    height: 580px;

    in-out property <string> search_text: "";
    in-out property <int> selected_index: 0;
    in-out property <length> scroll_viewport_y: 0px;
    in property <[LauncherItemData]> items: [];
    in property <bool> has_results: true;
    in property <string> mode_title: "APPLICATIONS";
    in property <bool> is_file_mode: false;
    in property <string> status_item_count: "0 apps";

    // Action Icons
    in property <image> settings_icon;
    in property <image> nav_icon;
    in property <image> enter_icon;

    // In-App Settings State
    in-out property <bool> in_settings_mode: false;
    in-out property <bool> cfg_show_icons: true;
    in-out property <bool> cfg_show_status_bar: true;
    in-out property <bool> cfg_enable_path_matching: true;
    in-out property <int> cfg_max_results: 7;
    in-out property <int> cfg_max_depth: 2;
    in-out property <string> settings_status: "";

    callback search_text_changed(string);
    callback move_up();
    callback move_down();
    callback item_activated(int);
    callback open_in_terminal(int);
    callback copy_path(int);
    callback open_config();
    callback close_settings();
    callback save_settings(bool, bool, bool, int, int);
    callback open_raw_config();
    callback close_window();
    callback start_window_drag();
    callback tab_pressed();
    callback handle_backspace() -> bool;

    forward-focus: search_input;

    init => {
        search_input.focus();
    }

    // Main Floating Glassmorphic Container (Dark Theme / Spotlight Aesthetic)
    main_card := Rectangle {
        width: 100%;
        height: 100%;
        background: #13141f;
        border-radius: 16px;
        border-width: 1.5px;
        border-color: #282c44;
        clip: true;

        // =========================================================
        // VIEW 1: SPOTLIGHT LAUNCHER VIEW
        // =========================================================
        search_view := VerticalLayout {
            visible: !root.in_settings_mode;
            padding-left: 18px;
            padding-right: 18px;
            padding-top: 10px;
            padding-bottom: 14px;
            spacing: 10px;

            // 0. DEDICATED VIRTUAL TITLEBAR & DRAG REGION (28px)
            title_bar := Rectangle {
                height: 28px;

                // Drag region TouchArea covers entire bar
                drag_region := TouchArea {
                    width: 100%;
                    height: 100%;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                            root.start_window_drag();
                        }
                    }
                }

                HorizontalLayout {
                    alignment: space-between;
                    padding-left: 4px;
                    padding-right: 2px;

                    // Left Brand / Title (Non-blocking)
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        Text {
                            text: "✦";
                            color: #7aa2f7;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "View Launcher";
                            color: #787c99;
                            font-size: 11px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    // Right Window Controls (Dedicated TouchArea)
                    HorizontalLayout {
                        alignment: end;
                        close_btn := Rectangle {
                            width: 22px;
                            height: 22px;
                            border-radius: 5px;
                            background: close_touch.has-hover ? #f7768e33 : transparent;

                            close_touch := TouchArea {
                                clicked => {
                                    root.close_window();
                                }
                            }

                            Text {
                                text: "✕";
                                color: close_touch.has-hover ? #f7768e : #565f89;
                                font-size: 11px;
                                font-weight: 800;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // 1. TOP SEARCH BAR CONTAINER
            search_box := Rectangle {
                height: 52px;
                background: #1b1e2e;
                border-radius: 12px;
                border-width: 1.5px;
                border-color: root.is_file_mode ? #2ac3de : (search_input.has-focus ? #7aa2f7 : #323854);
                animate border-color { duration: 180ms; easing: ease-out; }

                TouchArea {
                    clicked => {
                        search_input.focus();
                    }
                }

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 14px;
                    spacing: 12px;

                    // 1.1 Fixed Search Icon (Kính lúp)
                    HorizontalLayout {
                        alignment: center;
                        width: 22px;
                        Text {
                            text: root.is_file_mode ? "📂" : "🔍";
                            font-size: 16px;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }

                    // 1.2 Text Input & Shortened Placeholder
                    Rectangle {
                        horizontal-stretch: 1;

                        Text {
                            x: 0px;
                            width: 100%;
                            text: root.is_file_mode ? "Search files & folders (e.g. notes.pdf, ~/Projects)..." : "Search apps or type @ for files...";
                            color: #565f89;
                            font-size: 14px;
                            font-italic: true;
                            vertical-alignment: center;
                            horizontal-alignment: left;
                            visible: root.search_text == "";
                        }

                        search_input := TextInput {
                            x: 0px;
                            width: 100%;
                            text: root.search_text;
                            single-line: true;
                            font-size: 15px;
                            color: #f0f6fc;
                            selection-background-color: #3d59a1;
                            selection-foreground-color: #ffffff;
                            vertical-alignment: center;
                            horizontal-alignment: left;

                            edited => {
                                root.search_text = self.text;
                                root.search_text_changed(self.text);
                            }

                            key-pressed(event) => {
                                if (event.text == Key.Tab) {
                                    root.tab_pressed();
                                    return accept;
                                }
                                if (event.text == Key.Backspace) {
                                    if (root.handle_backspace()) {
                                        return accept;
                                    }
                                }
                                if (event.text == Key.Escape) {
                                    if (root.in_settings_mode) {
                                        root.close_settings();
                                        return accept;
                                    }
                                    root.close_window();
                                    return accept;
                                }
                                if (event.text == Key.Return) {
                                    root.item_activated(root.selected_index);
                                    return accept;
                                }
                                if (event.text == Key.DownArrow) {
                                    root.move_down();
                                    return accept;
                                }
                                if (event.text == Key.UpArrow) {
                                    root.move_up();
                                    return accept;
                                }
                                if (event.modifiers.control && event.text == ",") {
                                    root.open_config();
                                    return accept;
                                }
                                if (event.modifiers.alt && (event.text == "t" || event.text == "T")) {
                                    root.open_in_terminal(root.selected_index);
                                    return accept;
                                }
                                if (event.modifiers.alt && (event.text == "c" || event.text == "C")) {
                                    root.copy_path(root.selected_index);
                                    return accept;
                                }
                                return reject;
                            }
                        }
                    }

                    // 1.3 Segmented Control (Tabs: Mode + Settings Gear Icon)
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        // Mode Tab Pill
                        Rectangle {
                            height: 26px;
                            background: root.is_file_mode ? #122833 : #17223b;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: root.is_file_mode ? #2ac3de : #3d59a1;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                Text {
                                    text: root.mode_title;
                                    color: root.is_file_mode ? #2ac3de : #7dcfff;
                                    font-size: 11px;
                                    font-weight: 800;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Settings Gear Icon Button
                        settings_btn := Rectangle {
                            width: 30px;
                            height: 26px;
                            background: settings_touch.has-hover ? #2e3654 : #161824;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #343b58;
                            animate background, border-color { duration: 150ms; easing: ease-out; }

                            settings_touch := TouchArea {
                                clicked => {
                                    root.open_config();
                                }
                            }

                            HorizontalLayout {
                                alignment: center;
                                Image {
                                    source: root.settings_icon;
                                    width: 16px;
                                    height: 16px;
                                    image-fit: contain;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // 1.4 Subtle Quick Calc Hint (Beneath Search Box)
            if root.search_text == "" : HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                Text {
                    text: "💡 Tip: Type expressions like 500*12, 0xFF to decimal, or @f for files (Tab into folders)";
                    color: #485173;
                    font-size: 11px;
                    font-italic: true;
                    vertical-alignment: center;
                }
            }

            // 2. SCROLLABLE ITEM RESULTS LIST (Flickable / ListView with Auto-Scroll & 50-Item Capacity)
            list_container := Rectangle {
                vertical-stretch: 1;
                clip: true;

                // 2.1 Empty State with query quote
                Rectangle {
                    visible: !root.has_results;
                    VerticalLayout {
                        alignment: center;
                        spacing: 8px;
                        Text {
                            text: "🔍";
                            font-size: 32px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: (root.search_text != "") ? "No results for '\{root.search_text}'" : "No applications found";
                            font-size: 14px;
                            font-weight: 700;
                            color: #c0caf5;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Try searching for an app, file, or math command";
                            font-size: 12px;
                            color: #565f89;
                            horizontal-alignment: center;
                        }
                    }
                }

                // 2.2 Scrollable Virtual Container
                list_flickable := Flickable {
                    visible: root.has_results;
                    viewport-y <=> root.scroll_viewport_y;
                    viewport-height: root.items.length * 51px;

                    VerticalLayout {
                        spacing: 3px;
                        alignment: start;

                        for item[index] in root.items : item_row := Rectangle {
                            height: 48px;
                            // State Handling: Selected (Keyboard) vs Hover (Mouse) vs Default
                            background: (index == root.selected_index) ? #262f4d : (item_touch.has-hover ? #1a1e30 : transparent);
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: (index == root.selected_index) ? #3d59a1 : (item_touch.has-hover ? #24293f : transparent);
                            animate background, border-color { duration: 150ms; easing: ease-out; }

                            item_touch := TouchArea {
                                clicked => {
                                    root.selected_index = index;
                                    root.item_activated(index);
                                }
                            }

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 14px;
                                padding-top: 6px;
                                padding-bottom: 6px;
                                spacing: 12px;

                                // Left Glowing Accent Indicator Pill
                                HorizontalLayout {
                                    alignment: center;
                                    width: 3.5px;
                                    Rectangle {
                                        width: 3.5px;
                                        height: 24px;
                                        border-radius: 2px;
                                        background: (index == root.selected_index) ? #7dcfff : transparent;
                                        animate background { duration: 150ms; easing: ease-out; }
                                    }
                                }

                                // Standardized 32x32px Icon Container with 8px Radius & Solid Fallback Background
                                HorizontalLayout {
                                    alignment: center;
                                    width: 32px;

                                    Rectangle {
                                        width: 32px;
                                        height: 32px;
                                        border-radius: 8px;
                                        background: (item.item_type == "calc") ? #10b98126 : ((item.item_type == "dir") ? #38bdf826 : #1e2338);
                                        border-width: 1px;
                                        border-color: (item.item_type == "calc") ? #10b98140 : ((item.item_type == "dir") ? #38bdf840 : #2b324d);
                                        clip: true;

                                        // Real system icon
                                        if (root.cfg_show_icons && item.has_icon) : Image {
                                            source: item.icon;
                                            width: 26px;
                                            height: 26px;
                                            image-fit: contain;
                                        }

                                        // Fallback text/glyph icon
                                        if (!root.cfg_show_icons || !item.has_icon) : Text {
                                            text: (item.item_type == "calc") ? "=" : ((item.item_type == "dir") ? "📁" : "◆");
                                            color: (item.item_type == "calc") ? #10b981 : ((item.item_type == "dir") ? #38bdf8 : #7aa2f7);
                                            font-size: 14px;
                                            font-weight: 800;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Item Name Title
                                Text {
                                    text: item.name;
                                    color: (index == root.selected_index) ? #ffffff : #c0caf5;
                                    font-weight: (index == root.selected_index) ? 700 : 500;
                                    font-size: 14px;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                // Category Tag Badge with Type-Specific WCAG-AA Palette
                                HorizontalLayout {
                                    alignment: end;

                                    // Category Pill Container
                                    Rectangle {
                                        height: 24px;
                                        border-radius: 6px;
                                        border-width: 1px;

                                        // Background: 10% Opacity per Category
                                        background: (item.category == "Chat") ? #34D3991A :
                                                    ((item.category == "System" || item.category == "Folder") ? #FBBF241A :
                                                    ((item.category == "IDE" || item.category == "Development") ? #A78BFA1A :
                                                    ((item.category == "Calc") ? #10B9811A : #38BDF81A)));

                                        // Border: Accent Color per Category
                                        border-color: (item.category == "Chat") ? #34D39940 :
                                                      ((item.category == "System" || item.category == "Folder") ? #FBBF2440 :
                                                      ((item.category == "IDE" || item.category == "Development") ? #A78BFA40 :
                                                      ((item.category == "Calc") ? #10B98140 : #38BDF840)));

                                        HorizontalLayout {
                                            padding-left: 9px;
                                            padding-right: 9px;
                                            Text {
                                                text: item.category;
                                                // Text Color per Category
                                                color: (item.category == "Chat") ? #34D399 :
                                                       ((item.category == "System" || item.category == "Folder") ? #FBBF24 :
                                                       ((item.category == "IDE" || item.category == "Development") ? #A78BFA :
                                                       ((item.category == "Calc") ? #10B981 : #38BDF8)));
                                                font-size: 11px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Subtle Divider Line above Footer
            Rectangle {
                height: 1px;
                background: #ffffff0d; // 5% opacity divider
            }

            // 3. KEYBOARD AFFORDANCE FOOTER BAR (Crisp Vectors & Clean Badges)
            if root.cfg_show_status_bar : footer := Rectangle {
                height: 26px;

                HorizontalLayout {
                    alignment: space-between;

                    // Left: Keyboard Affordance Hints (Keycaps)
                    HorizontalLayout {
                        spacing: 14px;
                        alignment: start;

                        // Navigate (Vector Arrows)
                        HorizontalLayout {
                            spacing: 5px;
                            Rectangle {
                                background: #1b1e2e;
                                border-radius: 4px;
                                height: 19px;
                                width: 22px;
                                border-width: 1px;
                                border-color: #323854;
                                HorizontalLayout {
                                    alignment: center;
                                    Image {
                                        source: root.nav_icon;
                                        width: 12px;
                                        height: 12px;
                                        image-fit: contain;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                            Text { text: "Navigate"; color: #787c99; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                        }

                        // Tab In
                        if root.is_file_mode : HorizontalLayout {
                            spacing: 5px;
                            Rectangle {
                                background: #1b1e2e;
                                border-radius: 4px;
                                height: 19px;
                                border-width: 1px;
                                border-color: #323854;
                                HorizontalLayout {
                                    padding-left: 5px;
                                    padding-right: 5px;
                                    Text { text: "Tab"; color: #2ac3de; font-weight: 800; font-size: 11px; vertical-alignment: center; }
                                }
                            }
                            Text { text: "Enter Folder"; color: #787c99; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                        }

                        // Open (Vector Return Key)
                        HorizontalLayout {
                            spacing: 5px;
                            Rectangle {
                                background: #1b1e2e;
                                border-radius: 4px;
                                height: 19px;
                                width: 22px;
                                border-width: 1px;
                                border-color: #323854;
                                HorizontalLayout {
                                    alignment: center;
                                    Image {
                                        source: root.enter_icon;
                                        width: 12px;
                                        height: 12px;
                                        image-fit: contain;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                            Text { text: "Open"; color: #787c99; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                        }

                        // Esc Close
                        HorizontalLayout {
                            spacing: 5px;
                            Rectangle {
                                background: #1b1e2e;
                                border-radius: 4px;
                                height: 19px;
                                border-width: 1px;
                                border-color: #323854;
                                HorizontalLayout {
                                    padding-left: 5px;
                                    padding-right: 5px;
                                    Text { text: "Esc"; color: #f7768e; font-weight: 800; font-size: 11px; vertical-alignment: center; }
                                }
                            }
                            Text { text: "Close"; color: #787c99; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                        }

                        // Ctrl+, Settings
                        HorizontalLayout {
                            spacing: 5px;
                            Rectangle {
                                background: #1b1e2e;
                                border-radius: 4px;
                                height: 19px;
                                border-width: 1px;
                                border-color: #323854;
                                HorizontalLayout {
                                    padding-left: 5px;
                                    padding-right: 5px;
                                    Text { text: "Ctrl+,"; color: #7aa2f7; font-weight: 800; font-size: 11px; vertical-alignment: center; }
                                }
                            }
                            Text { text: "Settings"; color: #787c99; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                        }
                    }

                    // Right: Item Count
                    HorizontalLayout {
                        alignment: end;
                        Text {
                            text: root.status_item_count;
                            color: #565f89;
                            font-size: 11px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // =========================================================
        // VIEW 2: IN-APP PREFERENCES & SETTINGS VIEW
        // =========================================================
        settings_view := VerticalLayout {
            visible: root.in_settings_mode;
            padding-left: 22px;
            padding-right: 22px;
            padding-top: 14px;
            padding-bottom: 18px;
            spacing: 12px;

            // 0. Settings Drag Bar (28px)
            settings_title_bar := Rectangle {
                height: 28px;

                settings_drag_region := TouchArea {
                    width: 100%;
                    height: 100%;
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                            root.start_window_drag();
                        }
                    }
                }

                HorizontalLayout {
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text {
                            text: "⚙";
                            color: #7aa2f7;
                            font-size: 15px;
                            font-weight: 800;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "VIEW LAUNCHER PREFERENCES";
                            color: #ffffff;
                            font-size: 13px;
                            font-weight: 800;
                            vertical-alignment: center;
                        }
                    }

                    // Back Button [Esc]
                    back_btn := Rectangle {
                        height: 26px;
                        background: back_touch.has-hover ? #2e344f : #1b1e2e;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: #343b58;

                        back_touch := TouchArea {
                            clicked => {
                                root.close_settings();
                            }
                        }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 6px;
                            Text {
                                text: "← Back [Esc]";
                                color: #c0caf5;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: #ffffff0d; }

            // 1. Settings Content Area
            VerticalLayout {
                vertical-stretch: 1;
                spacing: 10px;

                // Group 1: Appearance
                Text {
                    text: "APPEARANCE & VISUALS";
                    color: #7aa2f7;
                    font-size: 11px;
                    font-weight: 800;
                }

                // Setting: Show App Icons
                Rectangle {
                    height: 40px;
                    background: #1b1e2e;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #282c44;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        alignment: space-between;
                        Text {
                            text: "Show Native Application Icons";
                            color: #c0caf5;
                            font-size: 13px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        toggle_icon := Rectangle {
                            width: 64px;
                            height: 26px;
                            border-radius: 13px;
                            background: root.cfg_show_icons ? #7aa2f7 : #343b58;
                            TouchArea {
                                clicked => {
                                    root.cfg_show_icons = !root.cfg_show_icons;
                                }
                            }
                            Text {
                                text: root.cfg_show_icons ? "ON" : "OFF";
                                color: root.cfg_show_icons ? #14151e : #a9b1d6;
                                font-size: 11px;
                                font-weight: 800;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Setting: Show Status Bar
                Rectangle {
                    height: 40px;
                    background: #1b1e2e;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #282c44;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        alignment: space-between;
                        Text {
                            text: "Show Bottom Keyboard Shortcuts Bar";
                            color: #c0caf5;
                            font-size: 13px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        toggle_bar := Rectangle {
                            width: 64px;
                            height: 26px;
                            border-radius: 13px;
                            background: root.cfg_show_status_bar ? #7aa2f7 : #343b58;
                            TouchArea {
                                clicked => {
                                    root.cfg_show_status_bar = !root.cfg_show_status_bar;
                                }
                            }
                            Text {
                                text: root.cfg_show_status_bar ? "ON" : "OFF";
                                color: root.cfg_show_status_bar ? #14151e : #a9b1d6;
                                font-size: 11px;
                                font-weight: 800;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Group 2: Search Engine
                Text {
                    text: "SEARCH & ENGINE";
                    color: #7aa2f7;
                    font-size: 11px;
                    font-weight: 800;
                }

                // Setting: Match Full Path
                Rectangle {
                    height: 40px;
                    background: #1b1e2e;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #282c44;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        alignment: space-between;
                        Text {
                            text: "Match Full File & Directory Paths";
                            color: #c0caf5;
                            font-size: 13px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        toggle_path := Rectangle {
                            width: 64px;
                            height: 26px;
                            border-radius: 13px;
                            background: root.cfg_enable_path_matching ? #2ac3de : #343b58;
                            TouchArea {
                                clicked => {
                                    root.cfg_enable_path_matching = !root.cfg_enable_path_matching;
                                }
                            }
                            Text {
                                text: root.cfg_enable_path_matching ? "ON" : "OFF";
                                color: root.cfg_enable_path_matching ? #14151e : #a9b1d6;
                                font-size: 11px;
                                font-weight: 800;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Setting: Max Results Selector
                Rectangle {
                    height: 40px;
                    background: #1b1e2e;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #282c44;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        alignment: space-between;
                        Text {
                            text: "Max Visible Search Results";
                            color: #c0caf5;
                            font-size: 13px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: end;

                            for num in [5, 7, 9] : Rectangle {
                                width: 36px;
                                height: 26px;
                                border-radius: 6px;
                                background: (root.cfg_max_results == num) ? #7aa2f7 : #14151e;
                                border-width: 1px;
                                border-color: (root.cfg_max_results == num) ? #7aa2f7 : #343b58;
                                TouchArea {
                                    clicked => {
                                        root.cfg_max_results = num;
                                    }
                                }
                                Text {
                                    text: "\{num}";
                                    color: (root.cfg_max_results == num) ? #14151e : #c0caf5;
                                    font-size: 12px;
                                    font-weight: 800;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // 2. Status Toast Notification
            if root.settings_status != "" : Text {
                text: root.settings_status;
                color: #9ece6a;
                font-size: 12px;
                font-weight: 700;
                horizontal-alignment: center;
            }

            Rectangle { height: 1px; background: #ffffff0d; }

            // 3. Action Buttons
            HorizontalLayout {
                height: 38px;
                spacing: 12px;
                alignment: end;

                // Button: Open Raw config.toml
                raw_btn := Rectangle {
                    background: raw_touch.has-hover ? #2e344f : #1b1e2e;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #343b58;

                    raw_touch := TouchArea {
                        clicked => {
                            root.open_raw_config();
                        }
                    }

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        Text {
                            text: "📝 Edit config.toml";
                            color: #c0caf5;
                            font-size: 12px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }

                // Button: Save & Apply
                save_btn := Rectangle {
                    background: save_touch.has-hover ? #9ece6a : #7aa2f7;
                    border-radius: 8px;

                    save_touch := TouchArea {
                        clicked => {
                            root.save_settings(
                                root.cfg_show_icons,
                                root.cfg_show_status_bar,
                                root.cfg_enable_path_matching,
                                root.cfg_max_results,
                                root.cfg_max_depth
                            );
                        }
                    }

                    HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        Text {
                            text: "💾 Save & Apply Changes";
                            color: #14151e;
                            font-size: 13px;
                            font-weight: 800;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
